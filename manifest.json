{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Salesforce Change Set Helper",
  "description": "Enhances the Salesforce change set. Adds last changed date and allows sorting, searching, validation and comparison with other orgs.",
  "version": "3.1.5",
  "options_page": "pages/options.html",
  "action": {
    "default_icon": "assets/icons/braincloudsmall.png",
    "default_popup": "pages/popup.html"
  },
  "icons": {
	 "128": "assets/icons/brainbulb128.png",
	 "48": "assets/icons/brainbulb48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/p/mfpkg/AddToPackageFromChangeMgmtUi*",
        "https://*.salesforce.com/p/mfpkg/AddToPackageUi*",
        "https://*.force.com/p/mfpkg/AddToPackageFromChangeMgmtUi*",
        "https://*.force.com/p/mfpkg/AddToPackageUi*",
        "https://*.cloudforce.com/p/mfpkg/AddToPackageFromChangeMgmtUi*",
        "https://*.cloudforce.com/p/mfpkg/AddToPackageUi*",
        "https://*.salesforce-setup.com/p/mfpkg/AddToPackageFromChangeMgmtUi*",
        "https://*.salesforce-setup.com/p/mfpkg/AddToPackageUi*"
      ],
      "css": [
        "lib/jquery.dataTables.css",
        "lib/mergely.css",
        "lib/codemirror.css",
        "lib/jquery-ui.min.css",
        "lib/jquery-ui.structure.min.css",
        "lib/jquery-ui.theme.min.css",
        "lib/dataTables.checkboxes.css",
        "css/changeset.css",
        "css/cart.css"
      ],
      "js": [
        "js/cshlogger.js",
        "lib/jquery.min.js",
        "lib/jquery.dataTables.js",
        "lib/jquery-ui.min.js",
        "lib/dataTables.checkboxes.min.js",
        "lib/codemirror.js",
        "lib/moment.js",
        "lib/searchcursor.js",
        "lib/jsforce.js",
        "lib/buttons.html5.min.js",
        "lib/jquery.json-viewer.js",
        "lib/select2.min.js",
        "lib/mergely.js",
        "lib/jszip.js",
        "js/common.js",
        "js/cshdb.js",
        "js/cart.js",
        "js/changeset.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://*.salesforce.com/*tab=PackageComponents*",
        "https://*.force.com/*tab=PackageComponents*",
        "https://*.cloudforce.com/*tab=PackageComponents*",
        "https://*.salesforce-setup.com/*tab=PackageComponents*"
      ],
      "css": [
        "lib/jquery.dataTables.css",
        "css/changeset.css"
      ],
      "js": [
        "js/cshlogger.js",
        "lib/jquery.min.js",
        "lib/jquery.dataTables.js",
        "lib/moment.js",
        "js/common.js",
        "js/cshdb.js",
        "js/changeview.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://*.salesforce.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.salesforce.com/lightning/setup/OutboundChangeSet/page*",
        "https://*.force.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.force.com/lightning/setup/OutboundChangeSet/page*",
        "https://*.cloudforce.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.cloudforce.com/lightning/setup/OutboundChangeSet/page*",
        "https://*.salesforce-setup.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.salesforce-setup.com/lightning/setup/OutboundChangeSet/page*"
      ],
      "css": [
        "lib/jquery.dataTables.css",
        "lib/jquery.json-viewer.css",
        "lib/select2.min.css",
        "lib/codemirror.css",
        "lib/dataTables.checkboxes.css",
        "css/changeset.css",
        "css/cart.css"
      ],
      "js": [
        "js/cshlogger.js",
        "lib/jquery.min.js",
        "lib/jquery.dataTables.js",
        "lib/jquery-ui.min.js",
        "lib/codemirror.js",
        "lib/dataTables.checkboxes.min.js",
        "lib/moment.js",
        "lib/buttons.html5.min.js",
        "lib/jquery.json-viewer.js",
        "lib/select2.min.js",
        "lib/FileSaver.js",
        "lib/jszip.js",
        "js/common.js",
        "js/cshdb.js",
        "js/cart.js",
        "js/metadatahelper.js",
        "js/deployhelper.js",
        "js/detailcomponents.js"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://*.salesforce.com/lightning/setup/OutboundChangeSet/home*",
        "https://*.salesforce.com/changemgmt/listOutboundChangeSet.apexp*",
        "https://*.force.com/lightning/setup/OutboundChangeSet/home*",
        "https://*.force.com/changemgmt/listOutboundChangeSet.apexp*",
        "https://*.cloudforce.com/lightning/setup/OutboundChangeSet/home*",
        "https://*.cloudforce.com/changemgmt/listOutboundChangeSet.apexp*",
        "https://*.salesforce-setup.com/lightning/setup/OutboundChangeSet/home*",
        "https://*.salesforce-setup.com/changemgmt/listOutboundChangeSet.apexp*"
      ],
      "js": [
        "js/cshlogger.js",
        "js/common.js",
        "js/cshdb.js",
        "js/outboundlist.js"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://*.salesforce.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.salesforce.com/lightning/setup/OutboundChangeSet/page*",
        "https://*.force.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.force.com/lightning/setup/OutboundChangeSet/page*",
        "https://*.cloudforce.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.cloudforce.com/lightning/setup/OutboundChangeSet/page*",
        "https://*.salesforce-setup.com/changemgmt/outboundChangeSetDetailPage.apexp*",
        "https://*.salesforce-setup.com/lightning/setup/OutboundChangeSet/page*"
      ],
      "js": [
        "js/detailpagebridge.js"
      ],
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "permissions": [
    "identity",
    "storage",
    "offscreen",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.cloudforce.com/*",
    "https://*.salesforce-setup.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/images/loading.gif"],
      "matches": ["https://*.salesforce.com/*", "https://*.force.com/*"]
    }
  ]
}
